// nested_break: break 只跳出最内层循环，外层继续
int main() {
    int count = 0;
    for (int i = 0; i < 3; i = i + 1) {
        for (int j = 0; j < 10; j = j + 1) {
            if (j == 2) {
                break;
            }
            count = count + 1;
        }
    }
    return count;    // 内层每次贡献 2，共 3 轮 → 6
}
