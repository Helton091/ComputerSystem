// basic: p±i 读写、i+p 交换律、经指针算术写入数组元素
int main(){
    int a[5];
    int i;
    i = 0;
    while(i < 5){
        a[i] = i * 2;    // 0,2,4,6,8
        i = i + 1;
    }
    int* p;
    p = &a[1];
    *(p + 2) = 100;      // a[3] = 100
    int s;
    s = *(1 + p);        // i+p：a[2] = 4
    s = s + *(p + 2);    // a[3] = 100 → 104
    s = s + a[3];        // 100 → 204
    p = p + 3;           // &a[4]
    s = s + *(p - 4);    // a[0] = 0 → 204
    return s;            // 期望 204
}
