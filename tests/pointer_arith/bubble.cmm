// bubble: 指针算术综合应用——冒泡排序的内层用双指针游标
int main(){
    int a[6];
    a[0] = 5;
    a[1] = 2;
    a[2] = 9;
    a[3] = 1;
    a[4] = 7;
    a[5] = 3;
    int i;
    i = 0;
    while(i < 5){
        int* p;
        p = &a[0];
        while(p < &a[5] - i){
            if(*p > *(p + 1)){
                int t;
                t = *p;
                *p = *(p + 1);
                *(p + 1) = t;
            }
            p = p + 1;
        }
        i = i + 1;
    }
    // 验证有序：a[0]=1, a[5]=9，且单调
    int ok;
    ok = 1;
    int* q;
    q = &a[0];
    while(q < &a[5]){
        if(*q > *(q + 1)) ok = 0;
        q = q + 1;
    }
    if(a[0] == 1) ok = ok + 10;
    if(a[5] == 9) ok = ok + 100;
    return ok;         // 期望 111
}
