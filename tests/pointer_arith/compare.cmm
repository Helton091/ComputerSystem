// compare: 指针关系比较真值表（按位分解，PTRDIFF 降级路径）
int main(){
    int a[5];
    a[0] = 1;
    a[1] = 2;
    a[2] = 3;
    a[3] = 4;
    a[4] = 5;
    int* p;
    p = &a[1];
    int* q;
    q = &a[3];
    int r;
    r = 0;
    if(p < q)  r = r + 1;         // 真
    if(p <= q) r = r + 10;        // 真
    if(p > q)  r = r + 100;       // 假
    if(p >= q) r = r + 1000;      // 假
    if(q > p)  r = r + 10000;     // 真
    if(q >= p) r = r + 100000;    // 真
    if(p == q) r = r + 1000000;   // 假
    if(p != q) r = r + 10000000;  // 真
    return r;                     // 期望 10110011
}
