void fill(int* p, int n) {
    int i = 0;
    while (i < n) {
        *(p + i) = i * i;
        i += 1;
    }
}

int sum(int* p, int n) {
    int s = 0;
    int i = 0;
    while (i < n) {
        s = s + *(p + i);
        i += 1;
    }
    return s;
}

int main() {
    int a[5];
    fill(a, 5);
    return sum(a, 5);
}
